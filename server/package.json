{
  "name": "othello-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Socket.IO game server for multiplayer Othello",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.18"
