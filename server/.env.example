# Port the HTTP + Socket.IO server listens on
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed browser origins ("*" allows any origin)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# How long a disconnected player's seat is held before the opponent may claim the win
RECONNECT_GRACE_MS=60000

# Room cleanup TTLs
WAITING_ROOM_TTL_MS=1800000
FINISHED_ROOM_TTL_MS=600000
ABANDONED_ROOM_TTL_MS=120000
SWEEP_INTERVAL_MS=30000

# Serve ../client/dist when it exists (production single-origin deploy)
SERVE_CLIENT=true

# debug | info | warn | error | silent
LOG_LEVEL=info
